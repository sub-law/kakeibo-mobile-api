# Laravel Next App .env.example file
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_TIMEZONE=Asia/Tokyo

# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kakeibo_public_db
DB_USERNAME=sail
DB_PASSWORD=password

# --- フロントエンドのURLを指定 ---
# 複数ある場合はカンマ区切りですが、まずはこれだけでOK
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# --- セッションの設定 ---
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
# Sail環境でlocalhost:3000からアクセスする場合、ここを .localhost にするか
# もしくは単純に localhost に設定します（ドメインを合わせるため）
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700

MEILISEARCH_NO_ANALYTICS=false

# --- CORSの設定 ---
# 実は Laravel 11 以降、.envにこれらを書いても
# 自動では反映されない（config/cors.phpを見に行く）仕組みになっています。
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_SUPPORTS_CREDENTIALS=true

## --- デフォルトユーザーの設定 ---    
DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=